PORT=3000

# Your ShieldLabs keys, from Integration > API keys in the dashboard.
# The Public Key goes to the browser; the Private API Key stays on the server.
SHIELDLABS_PUBLIC_KEY=your-public-key
SHIELDLABS_API_KEY=sec_your_private_api_key

# Optional: the History API host.
# SHIELDLABS_API_URL=https://account.shieldlabs.ai
